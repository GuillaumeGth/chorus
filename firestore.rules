rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users : lisible par tout utilisateur connecté (recherche), modifiable uniquement par le propriétaire
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Following : géré uniquement par le propriétaire
      match /following/{followedUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Playlists : accessible uniquement aux membres
    match /playlists/{playlistId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.members[request.auth.uid] == 'owner';

      // Mise à jour : membres uniquement (les contrôles fins sont côté client + service)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      allow delete: if request.auth != null
        && resource.data.members[request.auth.uid] == 'owner';

      // Tracks : membres en lecture, editors/owner en écriture
      match /tracks/{trackId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.memberUids;

        allow create: if request.auth != null
          && get(/databases/$(database)/documents/playlists/$(playlistId)).data.members[request.auth.uid] in ['owner', 'editor']
          && request.resource.data.addedBy == request.auth.uid;

        allow delete: if request.auth != null
          && (
            get(/databases/$(database)/documents/playlists/$(playlistId)).data.members[request.auth.uid] == 'owner'
            || (
              get(/databases/$(database)/documents/playlists/$(playlistId)).data.members[request.auth.uid] == 'editor'
              && resource.data.addedBy == request.auth.uid
            )
          );

        allow update: if false;
      }
    }

    // Chats : accessible uniquement aux participants
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Création d'un nouveau chat : l'utilisateur doit être dans la liste des participants
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Messages : accessible uniquement aux participants du chat parent
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);

        allow delete: if false;
      }
    }
  }
}
