{
  "name": "chorus",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build-android": "eas build --local --platform android --profile preview",
    "test": "jest",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:functions": "cd functions && npm run build && cd .. && firebase deploy --only functions",
    "deploy": "npm run deploy:functions && npm run deploy:rules",
    "distribute": "npm run build-android && firebase appdistribution:distribute \"$(ls -t build-*.apk | head -1)\" --app 1:380791680025:android:5d8f479e8700ab46dd8e88 --groups beta-testers"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-share-intent": "^5.1.1",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.9.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
